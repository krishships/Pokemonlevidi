 ) {
+    if (inputOverrideEnabled && port == 0 && index == 0) {
+        return (inputOverrideMask >> id) & 1 ? 1 : 0;
+    }
     if (input) {
         return input->getInputState(port, device, index, id);
     }
     return 0;
 }
 
+void LibretroDroid::setInputOverride(bool enabled, int32_t mask) {
+    inputOverrideEnabled = enabled;
+    inputOverrideMask = mask;
+}
+
+std::pair<int8_t*, size_t> LibretroDroid::getSystemRam() {
+    std::lock_guard<std::mutex> lock(coreLock);
+    if (!core || !core->retro_get_memory_data || !core->retro_get_memory_size) {
+        return {nullptr, 0};
+    }
+    auto size = core->retro_get_memory_size(RETRO_MEMORY_SYSTEM_RAM);
+    auto data = static_cast<int8_t*>(core->retro_get_memory_data(RETRO_MEMORY_SYSTEM_RAM));
+    if (!data || size == 0) {
+        return {nullptr, 0};
+    }
+    return {data, size};
+}
