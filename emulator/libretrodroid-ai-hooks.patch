+JNIEXPORT void JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_setInputOverride(
+    JNIEnv* env,
+    jclass obj,
+    jboolean enabled,
+    jint mask
+) {
+    LibretroDroid::getInstance().setInputOverride(enabled, mask);
+}
+
+// Returns a direct ByteBuffer aliasing system RAM, or null. The buffer is
+// only valid while the core is running; do not free it.
+JNIEXPORT jobject JNICALL Java_com_swordfish_libretrodroid_LibretroDroid_getSystemRam(
+    JNIEnv* env,
+    jclass obj
+) {
+    auto [data, size] = LibretroDroid::getInstance().getSystemRam();
+    if (data == nullptr || size == 0) {
+        return nullptr;
+    }
+    return env->NewDirectByteBuffer(data, static_cast<jlong>(size));
+}
